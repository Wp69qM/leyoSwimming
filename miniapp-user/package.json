{
  "name": "@leyo/miniapp-user",
  "version": "0.1.0",
  "private": true,
  "description": "leyoSwimming user miniapp",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "scss"
  },
  "scripts": {
    "dev": "npm run dev:weapp",
    "dev:weapp": "taro build --type weapp --watch",
    "dev:h5": "taro build --type h5 --watch",
    "build": "npm run build:weapp",
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx && stylelint src/**/*.{scss,css,less} && prettier --check src",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix && stylelint src/**/*.{scss,css,less} --fix && prettier --write src"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@leyo/shared": "0.1.0",
    "@tarojs/components": "^4.0.7",
    "@tarojs/helper": "^4.0.7",
    "@tarojs/plugin-framework-react": "^4.0.7",
    "@tarojs/plugin-platform-weapp": "^4.0.7",
    "@tarojs/react": "^4.0.7",
    "@tarojs/runtime": "^4.0.7",
    "@tarojs/taro": "^4.0.7",
    "@tarojs/webpack5-runner": "^4.0.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.11",
    "@tarojs/test-utils-react": "^0.1.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/webpack-env": "^1.18.4",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "babel-preset-taro": "^4.0.7",
    "css-loader": "^6.10.0",
    "eslint": "^8.57.0",
    "eslint-config-taro": "^4.0.7",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "react-refresh": "^0.14.0",
    "sass": "^1.71.1",
    "sass-loader": "^14.1.1",
    "style-loader": "^3.3.4",
    "stylelint": "^16.2.1",
    "stylelint-config-standard-scss": "^13.0.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3",
    "webpack": "^5.90.3"
  }
}
