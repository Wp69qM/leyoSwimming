{
  "compilerOptions": {
    "target": "ES2018",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": [
      "@tarojs/taro",
      "@types/react",
      "@types/react-dom",
      "@types/webpack-env",
      "jest"
    ]
  },
  "include": ["./src", "./tests", "./config", "./types"],
  "exclude": ["node_modules", "dist", ".temp", ".swc"]
}
