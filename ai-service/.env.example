# AI Service 本地开发环境配置模板

APP_NAME=leyo-ai-service
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# 内部接口安全 Token（需与 Java 后端配置保持一致）
INTERNAL_API_TOKEN=your-internal-api-token-here
JAVA_INTERNAL_BASE_URL=http://localhost:8080/api/internal/ai

# LLM 配置（OpenAI 兼容接口）
# 支持通义千问、Kimi、DeepSeek 等
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
# 如需真实对话，请替换为实际 API Key；空值时对话接口会报错
LLM_API_KEY=your-llm-api-key-here
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30

# Embedding 配置（OpenAI 兼容接口）
# 知识库索引/检索需要独立的 Embedding 模型，DeepSeek 不提供 embedding 接口
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 请替换为实际 Embedding API Key
EMBEDDING_API_KEY=your-embedding-api-key-here

# LangSmith 配置（LangChain 通过 LANGCHAIN_ 前缀读取）
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=leyoSwimming
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Redis 配置（会话缓存、限流）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=leyo1234
REDIS_DB=0

# 会话 Memory 配置
SESSION_MESSAGE_TTL_SECONDS=604800
SESSION_MAX_MESSAGES=20

# 限流配置
RATE_LIMIT_USER_PER_MINUTE=30
RATE_LIMIT_IP_PER_MINUTE=60

# 可信代理层数（Nginx/网关数量），0 表示直接面向客户端，忽略 X-Forwarded-For
TRUSTED_PROXY_COUNT=0

# Mock 模式（Java 内部接口未就绪时启用；生产环境必须关闭）
ENABLE_MOCK_DATA=false
