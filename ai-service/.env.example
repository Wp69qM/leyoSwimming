# AI Service 基础配置
APP_NAME=leyo-ai-service
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# 内部接口安全 Token（需与 Java 后端配置保持一致）
INTERNAL_API_TOKEN=your-internal-api-token-here
JAVA_INTERNAL_BASE_URL=http://leyo-backend:8080/api/internal/ai

# LLM 配置（OpenAI 兼容接口）
# 支持通义千问、Kimi、DeepSeek 等
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-llm-api-key-here
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30

# Redis 配置（会话缓存、限流）
REDIS_HOST=redis
REDIS_PORT=6379
# 生产环境必须替换为强密码，切勿使用默认弱密码
REDIS_PASSWORD=change_me_in_production
REDIS_DB=0

# 会话 Memory 配置
SESSION_MESSAGE_TTL_SECONDS=604800
SESSION_MAX_MESSAGES=20

# 限流配置
RATE_LIMIT_USER_PER_MINUTE=30
RATE_LIMIT_IP_PER_MINUTE=60

# 可信代理层数（Nginx/网关数量），0 表示直接面向客户端，忽略 X-Forwarded-For
TRUSTED_PROXY_COUNT=0

# Mock 模式（Java 内部接口未就绪时启用；生产环境必须关闭）
ENABLE_MOCK_DATA=false
