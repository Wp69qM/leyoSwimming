# 环境变量模板
# 复制为 .env 后填写真实值，.env 文件禁止提交到 Git

# MySQL
# 本阶段保持与开发环境一致，正式上线前建议改为强密码
MYSQL_ROOT_PASSWORD=leyo_root
MYSQL_DATABASE=leyo_dev
MYSQL_USER=leyo
MYSQL_PASSWORD=leyo_dev

# Redis（本地开发密码 leyo1234，正式上线前建议改为强密码）
REDIS_PASSWORD=leyo1234

# JWT（生产环境必须使用强随机字符串，长度 >= 64）
JWT_SECRET=dev-secret-change-in-production

# 手机号加密（生产环境必须使用强随机字符串，长度 >= 32 字节）
PHONE_ENCRYPTION_KEY=dev-phone-encryption-key-change-in-production

# 身份证号加密（生产环境必须使用强随机字符串，长度 >= 32 字节）
ID_CARD_ENCRYPTION_KEY=dev-id-card-encryption-key-change-in-production

# AI 服务（必填）
# 当 AI 服务在宿主机直接运行时（本阶段默认），指向宿主机 IP:8000
# 若改为 Docker 容器运行，可改为 http://leyo-ai-service:8000
AI_SERVICE_BASE_URL=http://<服务器IP>:8000
# 内部接口安全 Token，长度 >= 32，需与 ai-service 的 INTERNAL_API_TOKEN 保持一致
INTERNAL_API_TOKEN=your-internal-api-token-at-least-32-characters

# 短信/微信 mock 开关（MVP 阶段保持 true，无需真实服务商账号）
SMS_MOCK_ENABLED=true
SMS_MOCK_FIXED_CODE=123456
WECHAT_MOCK_ENABLED=true

# LLM 配置（OpenAI 兼容接口）
# 项目默认使用 DeepSeek，可按需切换为通义千问 / Kimi 等
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-llm-api-key-here
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30

# Embedding 配置（OpenAI 兼容接口）
# 知识库索引/检索需要独立的 Embedding 模型，DeepSeek 不提供 embedding 接口
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 请替换为实际 Embedding API Key
EMBEDDING_API_KEY=your-embedding-api-key-here

# LangSmith 配置（可选）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=leyoSwimming
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# AI 服务运行配置
APP_NAME=leyo-ai-service
APP_ENV=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# 会话与限流
SESSION_MESSAGE_TTL_SECONDS=604800
SESSION_MAX_MESSAGES=20
RATE_LIMIT_USER_PER_MINUTE=30
RATE_LIMIT_IP_PER_MINUTE=60

# 可信代理层数（Nginx 前置填 1，直接面向客户端填 0）
TRUSTED_PROXY_COUNT=1

# AI 服务 Mock 模式（Java 内部接口未就绪时启用；生产环境必须设为 false）
ENABLE_MOCK_DATA=false

# 生产访问地址：使用服务器 IP 或域名
# 示例：DOMAIN=123.45.67.89  或  DOMAIN=your-domain.com
DOMAIN=123.45.67.89

# 微信支付（本阶段不需要，预留）
WXPAY_MCH_ID=
WXPAY_API_V3_KEY=
WXPAY_CERT_PATH=
WXPAY_PRIVATE_KEY_PATH=
