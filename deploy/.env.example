# 开发环境环境变量模板
# 复制为 .env 后填写真实值，.env 文件禁止提交到 Git

# MySQL
MYSQL_ROOT_PASSWORD=leyo_root
MYSQL_DATABASE=leyo_dev
MYSQL_USER=leyo
MYSQL_PASSWORD=leyo_dev

# Redis（本地开发密码 leyo1234，生产环境必须设置强密码）
REDIS_PASSWORD=leyo1234

# JWT（生产环境必须使用强随机字符串，长度 >= 256 bit）
JWT_SECRET=dev-secret-change-in-production

# 手机号加密（生产环境必须使用强随机字符串，长度 >= 256 bit）
PHONE_ENCRYPTION_KEY=dev-phone-encryption-key-change-in-production

# 身份证号加密（生产环境必须使用强随机字符串，长度 >= 256 bit）
ID_CARD_ENCRYPTION_KEY=dev-id-card-encryption-key-change-in-production

# 微信小程序（用户端）
MINIAPP_USER_APPID=wx_user_appid_here
MINIAPP_USER_SECRET=wx_user_secret_here

# 微信小程序（教练端）
MINIAPP_COACH_APPID=wx_coach_appid_here
MINIAPP_COACH_SECRET=wx_coach_secret_here

# 短信服务（阿里云 / 腾讯云 / 网易云信）
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE_LOGIN=

# 对象存储（头像、证书图片）
OSS_PROVIDER=aliyun
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 微信支付（本批次不需要，但先预留）
WXPAY_MCH_ID=
WXPAY_API_V3_KEY=
WXPAY_CERT_PATH=
WXPAY_PRIVATE_KEY_PATH=
